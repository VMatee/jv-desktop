{
  "name": "jv-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs",
    "rust:check": "node scripts/cargo.mjs check -p jv-desktop-process --locked",
    "rust:test": "node scripts/cargo.mjs test -p jv-desktop-process --features test-fixture --locked",
    "rust:fmt": "node scripts/cargo.mjs fmt --all -- --check",
    "rust:clippy": "node scripts/cargo.mjs clippy -p jv-desktop-process --all-targets --features test-fixture --locked -- -D warnings",
    "tauri:test": "node scripts/cargo.mjs test -p jv-desktop --lib --locked",
    "tauri:check": "node scripts/cargo.mjs check -p jv-desktop --locked",
    "test:e2e": "node scripts/browser.mjs test",
    "browser:install": "node scripts/browser.mjs install chromium --only-shell"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
