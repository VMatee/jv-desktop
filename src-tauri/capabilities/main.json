{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: selected workspace, fixed JV bridge and memory-only authentication.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-choose-workspace",
    "allow-detect-backend",
    "allow-run-turn",
    "allow-cancel-turn",
    "allow-open-bridge",
    "allow-close-bridge",
    "allow-authenticate"
  ]
}
